# Copier en .env (local) ou saisir ces variables dans Portainer > Stack > Environment variables.
PUBLIC_URL=https://mcp.charlois.fr      # derrière un reverse-proxy TLS (Salesforce exige https pour le callback)
HUB_PORT=8080
TZ=Europe/Paris
CACHE_REFRESH_HOUR=3

# Salesforce — Connected App OAuth, scopes "api refresh_token", callback : $PUBLIC_URL/auth/salesforce/callback
SF_LOGIN_URL=https://login.salesforce.com   # ou https://test.salesforce.com (sandbox) / votre My Domain
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_OBJECTS=Account,Contact,Lead,Opportunity,Order,Case,Product2,Pricebook2

# Sage X3 24R1 — URL Syracuse + dossier, et le serveur OAuth2 (ex. Entra ID) déclaré dans Syracuse
SAGE_URL=https://x3.charlois.local:8124
SAGE_FOLDER=PROD
SAGE_REPRESENTATIONS=BPCUSTOMER,BPSUPPLIER,SINVOICE,PINVOICE,SORDER,PORDER,GACCENTRY,ITMMASTER
SAGE_OAUTH_AUTH_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/authorize
SAGE_OAUTH_TOKEN_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
SAGE_OAUTH_USERINFO_URL=https://graph.microsoft.com/oidc/userinfo
SAGE_OAUTH_CLIENT_ID=
SAGE_OAUTH_CLIENT_SECRET=
SAGE_OAUTH_SCOPE=openid email offline_access

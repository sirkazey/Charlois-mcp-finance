# Docker Desktop : cp .env.example .env ; docker compose -f docker-compose.dev.yml up -d --build (hub + bouchon) ; http://localhost:8080
# Avec le bouchon, seules ENCRYPTION_KEY et PUBLIC_URL sont nécessaires : chaque variable renseignée ci-dessous rebranche un vrai système.
# RÈGLE : jamais de commentaire sur la même ligne qu'une valeur vide (Docker Compose le lirait comme la valeur).

# Ouvrir le portail EXACTEMENT à cette adresse (le cookie et les callbacks OAuth y sont liés)
PUBLIC_URL=http://localhost:8080
# OBLIGATOIRE : openssl rand -hex 32 ; chiffre users.json (AES-256-GCM). À sauvegarder : perdue = jetons illisibles
ENCRYPTION_KEY=
# preprod (défaut) ou production (https obligatoire, mode démo masqué)
APP_ENV=preprod
# info ou debug (trace des appels d'outils)
LOG_LEVEL=info
# nombre de reverse-proxys devant le hub
TRUST_PROXY=1
# Pré-prod avec bouchon sur un serveur (Portainer) : http://mcp-stub:4000=>http://<hôte-préprod>:4000 (défaut : localhost)
BROWSER_URL_REWRITE=

# Salesforce — Connected App (scopes openid, api, refresh_token, offline_access ; callback <PUBLIC_URL>/auth/salesforce/callback)
# Vide = bouchon en pré-prod ; https://login.salesforce.com ou https://test.salesforce.com (sandbox) pour le vrai
SF_LOGIN_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Sage X3 24R1 — vide = bouchon en pré-prod (compose de base : simulateur interne YFAC, YCLIENT, ZVENTE)
SAGE_URL=
SAGE_FOLDER=
# bearer (défaut : coller seulement la clé) ou basic (login + clé)
SAGE_APIKEY_MODE=
# OAuth Sage X3, optionnel si vos collaborateurs utilisent une clé d'API
SAGE_OAUTH_AUTH_URL=
SAGE_OAUTH_TOKEN_URL=
SAGE_OAUTH_USERINFO_URL=
SAGE_OAUTH_CLIENT_ID=
SAGE_OAUTH_CLIENT_SECRET=
# avec Entra ID : openid offline_access api://<app-id-syracuse>/.default
SAGE_OAUTH_SCOPE=

# SharePoint / OneDrive — app Entra ID, permissions déléguées lecture (callback <PUBLIC_URL>/auth/sharepoint/callback)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SP_SITE=

# Dropbox — app Dropbox (scopes account_info.read, files.metadata.read, files.content.read, sharing.read)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# MyReport — URL SSE du serveur MCP de votre MyReport Server (vide = bouchon en pré-prod, simulateur interne sinon)
MYREPORT_MCP_URL=
MYREPORT_AUTH_HEADER=
# liste blanche (lecture seule) des outils à transférer, d'après le bouton « Tester MyReport »
MYREPORT_TOOLS=

# Clevoa — clé client de licence ; télémétrie anonyme au démarrage puis chaque jour à 03:00 (vide = désactivée)
CLEVOA_KEY=
CLEVOA_URL=

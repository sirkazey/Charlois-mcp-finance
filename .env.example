# Docker Desktop : cp .env.example .env ; docker compose -f docker-compose.dev.yml up -d --build (hub + bouchon) ; http://localhost:8080
# Avec le bouchon, seules ENCRYPTION_KEY et PUBLIC_URL sont nécessaires : chaque variable renseignée ci-dessous rebranche un vrai système.
# RÈGLE : jamais de commentaire sur la même ligne qu'une valeur vide (Docker Compose le lirait comme la valeur).

# Ouvrir le portail EXACTEMENT à cette adresse (le cookie et les callbacks OAuth y sont liés)
PUBLIC_URL=http://localhost:8080
# OBLIGATOIRE : openssl rand -hex 32 ; chiffre users.json (AES-256-GCM). À sauvegarder : perdue = jetons illisibles
ENCRYPTION_KEY=
# preprod (défaut) ou production (https obligatoire, mode démo masqué)
APP_ENV=preprod
# info ou debug (trace des appels d'outils)
LOG_LEVEL=info
# nombre de reverse-proxys devant le hub
TRUST_PROXY=1
# Pré-prod avec bouchon sur un serveur (Portainer) : http://mcp-stub:4000=>http://<hôte-préprod>:4000 (défaut : localhost)
BROWSER_URL_REWRITE=

# Salesforce — serveur MCP hébergé « SObject Reads » (Configuration → Serveurs MCP → URL du serveur) et External Client App
# (OAuth activé, scopes « Access Salesforce hosted MCP servers » + « Perform requests at any time », PKCE, jetons JWT,
# callback <PUBLIC_URL>/auth/salesforce/callback). Vide = bouchon en pré-prod.
# SF_LOGIN_URL = My Domain : https://charloisgroup.my.salesforce.com, ou https://charloisgroup--<nom>.sandbox.my.salesforce.com
SF_LOGIN_URL=
SF_MCP_URL=
SF_CLIENT_ID=
# vide si l'External Client App n'exige pas de secret
SF_CLIENT_SECRET=
# défaut : mcp_api refresh_token ; ajouter openid si l'app l'autorise (affiche l'email)
SF_SCOPE=
# liste blanche optionnelle d'outils ; vide = tous les outils du serveur SObject Reads
SF_MCP_TOOLS=

# Sage X3 24R1 — vide = bouchon en pré-prod (compose de base : simulateur interne YFAC, YCLIENT, ZVENTE)
# Instance réelle : SAGE_URL = racine Syracuse (ex. https://x3-test-ext-….4cadcloud2.com), SAGE_FOLDER = NOM du point de
# connexion (colonne « Nom » de la liste Points de connexion, ex. X3TST_CHREC), pas l'intitulé ni le dossier X3.
SAGE_URL=
SAGE_FOLDER=
# représentations exposées (le diagnostic signale celles absentes du dossier) ; défaut : les 8 standards ci-dessous
SAGE_REPRESENTATIONS=BPCUSTOMER,BPSUPPLIER,SINVOICE,PINVOICE,SORDER,PORDER,GACCENTRY,ITMMASTER
# langue des libellés renvoyés par Syracuse (défaut fr-FR,fr)
SAGE_LANG=
# bearer (défaut : coller seulement la clé) ou basic (login Syracuse + mot de passe, vérifié sur 24R1)
SAGE_APIKEY_MODE=
# OAuth Sage X3, optionnel si vos collaborateurs utilisent une clé d'API
SAGE_OAUTH_AUTH_URL=
SAGE_OAUTH_TOKEN_URL=
SAGE_OAUTH_USERINFO_URL=
SAGE_OAUTH_CLIENT_ID=
SAGE_OAUTH_CLIENT_SECRET=
# avec Entra ID : openid offline_access api://<app-id-syracuse>/.default
SAGE_OAUTH_SCOPE=

# SharePoint / OneDrive — app Entra ID, permissions déléguées lecture (callback <PUBLIC_URL>/auth/sharepoint/callback)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SP_SITE=

# Dropbox — app Dropbox (scopes account_info.read, files.metadata.read, files.content.read, sharing.read)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# MyReport — URL SSE du serveur MCP de votre MyReport Server (vide = bouchon en pré-prod, simulateur interne sinon)
MYREPORT_MCP_URL=
MYREPORT_AUTH_HEADER=
# liste blanche (lecture seule) des outils à transférer, d'après le bouton « Tester MyReport »
MYREPORT_TOOLS=
# MyReport n'a qu'une production : plafond d'appels sortants par minute, tous utilisateurs confondus (défaut 20, 0 = illimité)
MYREPORT_MAX_PER_MIN=

# Clevoa — clé client de licence ; télémétrie anonyme au démarrage puis chaque jour à 03:00 (vide = désactivée)
CLEVOA_KEY=
CLEVOA_URL=

# Docker Desktop : cp .env.example .env ; docker compose up -d --build ; http://localhost:8080
PUBLIC_URL=http://localhost:8080

# Salesforce — Connected App (scopes openid, api, refresh_token ; callback http://localhost:8080/auth/salesforce/callback)
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Sage X3 24R1 — laisser SAGE_URL vide pour le mode simulé (tables YFAC, YCLIENT, ZVENTE)
SAGE_URL=
SAGE_FOLDER=PROD
SAGE_APIKEY_MODE=bearer      # clé d'API personnelle saisie dans le portail : bearer (Authorization: Bearer clé) ou basic (login:clé)
# OAuth Sage X3, optionnel si vos collaborateurs utilisent une clé d'API
SAGE_OAUTH_AUTH_URL=
SAGE_OAUTH_TOKEN_URL=
SAGE_OAUTH_USERINFO_URL=
SAGE_OAUTH_CLIENT_ID=
SAGE_OAUTH_CLIENT_SECRET=
SAGE_OAUTH_SCOPE=openid offline_access api://<app-id-syracuse>/.default

# SharePoint / OneDrive — app Entra ID, permissions déléguées lecture (callback http://localhost:8080/auth/sharepoint/callback)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SP_SITE=

# Dropbox — app Dropbox (scopes account_info.read, files.metadata.read, files.content.read, sharing.read)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_MCP_URL=

# MyReport — URL SSE du serveur MCP de votre MyReport Server (vide = simulateur local pour Docker Desktop)
MYREPORT_MCP_URL=
MYREPORT_AUTH_HEADER=Authorization
